# ============================================================================
# .gitignore — Protex Wear (Next.js)
# ============================================================================

# --- Dependencias ---
/node_modules
infrastructure/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Testing ---
/coverage

# --- Next.js ---
/.next/
/out/

# --- Producción ---
/build
/dist

# --- AWS Amplify (artefactos generados) ---
.amplify/
infrastructure/cdk.out/

# --- Misc ---
.DS_Store
*.pem
Thumbs.db

# --- Debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Variables de entorno ---
.env*
!.env.local.example

# --- Vercel ---
.vercel

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- IDE ---
.vscode/
.idea/
