   "Type": "AWS::AppSync::GraphQLSchema",
   "Properties": {
    "ApiId": {
     "Fn::GetAtt": [
      "ProtexWearApi2D35C46F",
      "ApiId"
     ]
    },
    "Definition": "type Product @aws_api_key @aws_cognito_user_pools {\n  id: ID!\n  name: String!\n  description: String\n  brand: String!\n  category: String\n  variants: [Variant!]!\n  createdAt: String\n  updatedAt: String\n}\n\ntype Variant @aws_api_key @aws_cognito_user_pools {\n  id: ID!\n  sku: String!\n  size: String\n  color: String\n  basePrice: Float!\n  images: [String]\n}\n\ntype Query {\n  # Obtener un producto por ID. Usa Lambda resolver para inyectar precio VIP si el usuario está logueado.\n  getProduct(id: ID!): Product @aws_api_key @aws_cognito_user_pools\n  \n  # Listar productos (con paginación simple y filtro)\n  listProducts(brand: String, limit: Int, nextToken: String): ProductConnection! @aws_api_key @aws_cognito_user_pools\n}\n\ntype ProductConnection @aws_api_key @aws_cognito_user_pools {\n  items: [Product!]!\n  nextToken: String\n}\n\nenum PaymentMethod {\n  STANDARD\n  DEFERRED\n}\n\ninput CreateOrderInput {\n  type: PaymentMethod!\n  items: [OrderItemInput!]!\n}\n\ninput OrderItemInput {\n  productId: ID!\n  variantId: ID!\n  quantity: Int!\n}\n\ntype OrderResponse {\n  orderId: ID!\n  checkoutUrl: String\n  status: String!\n}\n\ntype Mutation {\n  createOrder(input: CreateOrderInput!): OrderResponse @aws_api_key @aws_cognito_user_pools\n}\n"
   },
   "Metadata": {
    "aws:cdk:path": "EcommerceProtexWearStack/ProtexWearApi/Schema"
   }
  },
